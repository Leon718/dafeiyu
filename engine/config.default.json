    "projects": {
      "_doc": "目录名 → 她嘴里怎么称呼。默认空着：没配的目录她用目录名本身。值为空字符串表示别提这个项目（日期式目录名念出来像乱码，可以这样静音）"
    }
  },
  "gate": {
    "_doc": "闸门只管「她主动来打扰」。他找她、他回来、他戳她这些回应类时刻不占预算也不吃冷却（见 hook-mapper 的 FREE_MOMENTS）。每小时 12 次是兜底，真正的防话痨是 watch.js 的去重窗口和 60 秒冷却。注：右键「活跃度」会按倍率缩放 maxPerHour 和 globalCooldownMs（标准 1 倍；静默 0 倍，她自己不出来；高 2 倍预算、0.5 倍冷却），这里写的是「标准」那一档的底数",
    "maxPerHour": 12,
    "globalCooldownMs": 60000,
    "longRunMs": 1200000,
    "comebackGapMs": 1800000,
    "reportBackMinMs": 480000,
    "reportBackMinActs": 3,
    "reportBackMinFails": 3,
    "idleLongMs": 900000,
    "nightFromHour": 23,
    "nightFromMin": 30,
    "nightToHour": 5,
    "thoughtChance": 0.55
  },
