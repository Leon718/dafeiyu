    "width": 360,
    "height": 380,
    "scale": 1.22,
    "alwaysOnTop": true,
    "clickThrough": false
  },
  "_personaDir": "她的人格目录由 engine/paths.js 决定（DAFEIYU_HOME → userData/persona → content/），不在这里配，避免两处打架",
  "presence": {
    "_doc": "出场/退场。她不常驻桌面：被召唤才淡入，没人理就淡出并隐藏窗口。hideAfterMs 只是出厂默认，真值在右键「停留时间」里，存在 pet-prefs.json",
    "hideAfterMs": 20000,
    "quitAfterMs": 1200000,
    "fadeInMs": 420,
    "fadeOutMs": 720
  },
  "ledger": {
    "_doc": "他点「积分累计使用」时的演出。数字从 0 滚上去，然后按累计消耗换钱袋：花得越多，袋子越空",
    "countingAnim": "吃Token",
    "fallbackAnim": "余额-袋空如洗",
    "tiers": [
      {
        "maxCredits": 5,
        "anim": "余额-钱袋满溢"
