      },
      {
        "maxCredits": 200,
        "anim": "余额-分文不剩"
      }
    ]
  },
  "echo": {
    "_doc": "复读：她在聊天窗口说完一句（Stop），桌面上的她按她的换行把这句话再念一遍，一句一拍。读本地转录，零积分。enabled 关掉就只在「时刻」说话",
    "enabled": true,
    "maxBeats": 3,
    "maxChars": 60,
    "anim": "碎碎念-对屏碎碎念"
  },
  "journal": {
    "_doc": "替她记账：她停止回话时，把他这一轮的原话抄进 .workbuddy/memory/YYYY-MM-DD.md。读本地转录，零积分、零模型往返，不增加他的等待。只在她家生效",
    "enabled": true,
    "maxChars": 60
  },
  "brain": {
    "_doc": "深思：唯一会花钱的一层。规则决定要不要开口（频率不变），模型只决定这一句能说多深。价值只在「规则做不了、卡里恰好有素材」的四个时刻：读报错原文 / 看未提交的 diff / 看时间线形状 / 猜他在把什么改成什么。任何一步失败都静默退回规则那句",
    "_cost": "一次 2.6~5 秒（流式首句，实测暖缓存 2.6 秒）。maxPerHour=3 是硬上限，正常运行一天不到 20 次",
    "enabled": true,
    "provider": "claude",
    "model": "haiku",
    "timeoutMs": 18000,
    "softTimeoutMs": 12000,
    "maxPerHour": 3,
    "minGapMs": 100000,
    "sameAnchorHours": 12,
    "maxOutputChars": 40,
    "minErrChars": 160,
    "minDigActions": 3,
    "deepDelayMs": 850,
    "holdMs": 14000,
    "baseUrl": "",
    "apiKey": "",
    "claudePath": ""
  },
  "watch": {
    "_doc": "她看得见什么：不读代码，只读动作（哪个项目 / 什么工具 / 改哪个文件 / 跑什么命令 / 成没成）。数据全在 hook payload 里，零积分。详见 watch.js",
